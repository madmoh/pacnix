#!/usr/bin/env python3
# Caching package proxy for the test VMs: tests/pkgcache [port]. VMs list it as
# the first mirror, with a date of the Arch Linux Archive: /repos/YYYY/MM/DD/.
# The files of a date do not change, thus the proxy keeps the databases too.
# Package files are kept by name. Other paths go to the upstream mirrors, in
# order, and only their package files are kept. A package file that the mirrors
# no longer have comes from the Arch Linux Archive. The paths /nix/ go to
# cache.nixos.org, and the proxy keeps their files, which do not change.
import email.utils
import http.server
import os
import shutil
import socketserver
import sys
import threading
import urllib.request

UPSTREAM = ["https://fastly.mirror.pkgbuild.com", "https://mirror.rackspace.com/archlinux"]
CACHE = os.path.join(os.environ.get("PACNIX_VM_CACHE", os.path.expanduser("~/.cache/pacnix-vm")), "pkgcache")


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        path = self.path.split("?")[0]
        name = os.path.basename(path)
        package = ".pkg.tar." in name
        dated = path.startswith("/repos/")
        nix = path.startswith("/nix/")
        cacheable = (package or dated or nix) and ".." not in path
        local = os.path.join(CACHE, name if package else path.lstrip("/"))
        if cacheable and os.path.exists(local):
            # A kept file does not change and has the time of upstream: pacman
            # gets 304 for the database that it has, as from nginx on a mirror.
            mtime = int(os.path.getmtime(local))
            if self.headers.get("If-Modified-Since") == email.utils.formatdate(mtime, usegmt=True):
                self.send_response(304)
                return self.end_headers()
            return self.send(open(local, "rb"), os.path.getsize(local), mtime)
        os.makedirs(os.path.dirname(local), exist_ok=True)
        archive = "https://archive.archlinux.org/packages/%s/%s/%s" % (name[0], name.rsplit("-", 3)[0], name)
        if nix:
            upstreams = ["https://cache.nixos.org" + path[4:]]
        elif dated:
            upstreams = ["https://archive.archlinux.org" + path]
        else:
            upstreams = [base + path for base in UPSTREAM]
        for url in upstreams + ([archive] if package else []):
            try:
                upstream = urllib.request.urlopen(url, timeout=8)
            except Exception:
                continue
            if not cacheable:
                return self.send(upstream, upstream.headers.get("Content-Length"))
            # Streams to the client and to the cache at the same time, so that
            # pacman sees progress from the first byte.
            tmp = "%s.part%d" % (local, threading.get_ident())
            self.send_response(200)
            for header in ["Content-Length", "Last-Modified"]:
                if upstream.headers.get(header):
                    self.send_header(header, upstream.headers.get(header))
            self.end_headers()
            # A stopped upstream ends the response early after the timeout,
            # and the client tries again.
            try:
                with upstream, open(tmp, "wb") as f:
                    while chunk := upstream.read(65536):
                        f.write(chunk)
                        self.wfile.write(chunk)
                if upstream.headers.get("Last-Modified"):
                    mtime = email.utils.parsedate_to_datetime(upstream.headers.get("Last-Modified")).timestamp()
                    os.utime(tmp, (mtime, mtime))
                os.replace(tmp, local)
            finally:
                if os.path.exists(tmp):
                    os.remove(tmp)
            return
        self.send_error(404)

    def send(self, stream, length, mtime=None):
        self.send_response(200)
        if length:
            self.send_header("Content-Length", str(length))
        if mtime:
            self.send_header("Last-Modified", email.utils.formatdate(mtime, usegmt=True))
        self.end_headers()
        with stream:
            shutil.copyfileobj(stream, self.wfile)

    def log_message(self, *args):
        pass


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True

    # pacman closes the connection of a download that another mirror completes.
    def handle_error(self, request, address):
        if not isinstance(sys.exc_info()[1], ConnectionError):
            super().handle_error(request, address)


os.makedirs(CACHE, exist_ok=True)
Server(("192.168.123.1", int(sys.argv[1]) if len(sys.argv) > 1 else 8090), Handler).serve_forever()
