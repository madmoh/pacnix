# Kernel command line and initramfs settings through drop-ins, regenerated by triggers.
{ config, lib, ... }:
let
  cfg = config.features.boot;
in
{
  options.features.boot = {
    enable = lib.mkEnableOption "kernel command line and initramfs drop-ins";
    cmdline = lib.mkOption {
      type = lib.types.str;
      default = "";
    };
    compression = lib.mkOption {
      type = lib.types.enum [ "zstd" "xz" "lz4" "gzip" ];
      default = "zstd";
    };
  };
  config = lib.mkIf cfg.enable {
    files."/etc/default/grub.d/50-boot.cfg".text = ''
      GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT ${cfg.cmdline}"
    '';
    files."/etc/mkinitcpio.conf.d/50-boot.conf".text = ''
      COMPRESSION="${cfg.compression}"
    '';
    triggers.mkinitcpio = { paths = [ "/etc/mkinitcpio.conf" "/etc/mkinitcpio.conf.d/" ]; command = "mkinitcpio -P"; };
    triggers.grub = { paths = [ "/etc/default/grub" "/etc/default/grub.d/" ]; command = "grub-mkconfig -o /boot/grub/grub.cfg"; };
  };
}
