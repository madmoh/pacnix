# A split package whose version comes from pkgver(), thus each build has a new version.
pkgbase=split
pkgname=(split-a split-b)
pkgver=1
pkgrel=1
pkgdesc='pacnix test package with two packages and a version of the build time'
arch=(any)
license=(MIT)

pkgver() {
  printf '1.%s' "$(date +%s%N)"
}

package_split-a() {
  install -Dm644 /dev/null "$pkgdir/usr/share/split/a"
}

package_split-b() {
  install -Dm644 /dev/null "$pkgdir/usr/share/split/b"
}
