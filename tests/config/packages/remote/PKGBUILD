# A package with a source from the network, for the download retries.
pkgname=remote
pkgver=1
pkgrel=1
pkgdesc='pacnix test package with a remote source'
arch=(any)
license=(MIT)
source=("lastupdate::https://fastly.mirror.pkgbuild.com/lastupdate")
sha256sums=(SKIP)

package() {
  install -Dm644 lastupdate "$pkgdir/usr/share/remote/lastupdate"
}
