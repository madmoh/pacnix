# A build that behaves like a large download: colored output, a progress
# meter that redraws its line, no output for 65 s, then a meter that redraws
# its line two times each second for 65 s.
# It fails while its source file mode has the word fail. Its download stays
# for the next attempt.
pkgname=slow
pkgver=1
pkgrel=1
pkgdesc='pacnix test package with slow, silent build steps'
arch=(any)
license=(MIT)
source=(mode "lastupdate::https://fastly.mirror.pkgbuild.com/lastupdate")
sha256sums=(SKIP SKIP)

build() {
  if [[ $(<"$srcdir/mode") == fail ]]; then
    echo "error: the test build timed out while the file mode has the word fail" >&2
    return 1
  fi
  printf '\e[1;32m==>\e[0m colored line\n'
  for i in 10 50 90; do
    printf '\rprogress %d%%' "$i"
    sleep 1
  done
  printf '\rprogress done\n'
  sleep 65
  for ((i = 1; i <= 130; i++)); do
    printf '\rdownloaded %d MB' "$i"
    sleep 0.5
  done
  printf '\n'
}

package() {
  install -Dm644 /dev/null "$pkgdir/usr/share/slow/done"
}
