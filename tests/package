#!/usr/bin/env bash
# Builds the pacnix packages on the host, and the latest aurutils, into the test
# repository [pacnix] of the VMs: the same packages as a release, signed with a
# test key in place of the release key. The build directory stays, for an
# incremental cargo build. No root is needed.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cache=${PACNIX_VM_CACHE:-$HOME/.cache/pacnix-vm}
out=$cache/pkg
export GNUPGHOME=$cache/gnupg
if [[ ! -d $GNUPGHOME ]]; then
	mkdir -m700 "$GNUPGHOME"
	gpg --batch --quiet --passphrase '' --quick-gen-key 'pacnix test' ed25519 sign never
fi
key=$(gpg --list-secret-keys --with-colons | awk -F: '/^fpr/ { print $10; exit }')
mkdir -p "$out"
rm -f "$out"/pacnix-*.pkg.tar.zst* "$out"/pacnix.* "$out"/aurutils-*.sig
gpg --armor --export "$key" >"$out/test-key.asc"
cd "$root"
BUILDDIR=$out/build PKGDEST=$out PACNIX_KEY=$out/test-key.asc makepkg -df --noconfirm >/dev/null 2>&1
pkg/aurutils "$out" >/dev/null 2>&1
for pkg in "$out"/*.pkg.tar.zst; do
	gpg --batch --detach-sign --local-user "$key" "$pkg"
done
repo-add -q --sign --key "$key" "$out/pacnix.db.tar.gz" "$out"/*.pkg.tar.zst
ls "$out"/*.pkg.tar.zst
