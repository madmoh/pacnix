#!/usr/bin/env bash
# Builds the pacnix package on the host, and the latest aurutils, into the test
# repository [pacnix] of the VMs: the same packages as a release. No root is needed.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
out=${PACNIX_VM_CACHE:-$HOME/.cache/pacnix-vm}/pkg
mkdir -p "$out"
rm -f "$out"/pacnix-*.pkg.tar.zst "$out"/pacnix.*
cd "$root"
BUILDDIR=$out/build PKGDEST=$out makepkg -df --noconfirm >/dev/null 2>&1
rm -rf "$out/build"
pkg/aurutils "$out" >/dev/null 2>&1
repo-add -q "$out/pacnix.db.tar.gz" "$out"/*.pkg.tar.zst
ls "$out"/*.pkg.tar.zst
